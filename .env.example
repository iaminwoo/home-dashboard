# 집 위치(선택): 주차 지도에 조용한 "집" 마커로 표시됩니다.
NEXT_PUBLIC_HOME_LATITUDE=
NEXT_PUBLIC_HOME_LONGITUDE=

# 기존 Supabase 프로젝트를 연결할 때 채우세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 기상청 API 허브에서 발급한 초단기실황 API 인증키(authKey)를 넣으세요.
KMA_API_KEY=

# Google Calendar API: 서버에서만 사용하는 서비스 계정 정보 (NEXT_PUBLIC_ 사용 금지)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"